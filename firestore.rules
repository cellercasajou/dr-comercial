rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permetre lectura i escriptura a les col·leccions del CRM
    match /distributors/{distributorId} {
      allow read, write: if true;
    }
    match /access_logs/{logId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
